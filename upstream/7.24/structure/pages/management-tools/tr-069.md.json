        {
          "row": 1,
          "col": 1,
          "html": "informative status of CWMP.<ul><li>disabled - protocol disabled,</li><li>waiting-URL - protocol enabled, but ACS URL not configured,</li><li>running - CWMP is configured correctly and will communicate with ACS on events</li></ul>"
        }
