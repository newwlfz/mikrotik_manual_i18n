      "cells": [
        {
          "row": 1,
          "col": 1,
          "html": "Allows enabling QoS for the given switch chip (if it supports QoS). <br/> New generation devices force <strong>qos-hw-offloading=yes</strong> at all times."
        }
      ]
    },
    {
      "index": 6,
