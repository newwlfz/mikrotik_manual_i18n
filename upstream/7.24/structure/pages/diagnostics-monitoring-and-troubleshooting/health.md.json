      "md_wide": false,
      "cells": [
        {
          "row": 1,
          "col": 1,
          "html": "Sets the temperature value upon which the fan speed will be increased to the maximum possible rpm. <br/> Reads temperature from CPU, PHY, SWITCH and SFP and adjusts fan speed based on the component with the highest temperature."
        },
        {
          "row": 4,
          "col": 1,
          "html": "Sets the actual temperature data read interval to get temperature values from CPU, PHY, SWITCH and SFP. <br/><strong>*NOTE:</strong> THIS SETTING DIRECTLY AFFECTS CPU USAGE"
        },
        {
          "row": 5,
          "col": 1,
          "html": "Enables/disables CPU overtemperature monitoring. <br/><em>(Available for ARM/ARM64 devices)</em>"
        }
      ]
    }
