      "cells": [
        {
          "row": 21,
          "col": 1,
          "html": "Determines where the fetched data is stored: <ul><li><code>none</code> - do not store downloaded data</li><li><code>file</code> - store downloaded data in a file</li><li><code>user</code> - store downloaded data in the data variable (variable limit is 64Kb)</li><li><code>user-with-headers</code> - store downloaded data and headers in the data variable (variable limit is 64Kb - 20Kb for downloaded data, 44Kb for headers)</li></ul>"
        }
      ]
    }
