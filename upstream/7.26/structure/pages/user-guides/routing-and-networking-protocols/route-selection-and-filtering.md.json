      "cells": [
        {
          "row": 3,
          "col": 4,
          "html": "<strong>Match:</strong><br/> 1234 <br/> 1234 1234 1234 <br/> Null path <br/><strong>No Match:</strong><br/> 1234 5678"
        },
        {
          "row": 4,
          "col": 4,
          "html": "<strong>Match:</strong><br/> 1234 <br/> 3 1234 6 <br/><strong>No match:</strong><br/> 12345 678"
        },
        {
          "row": 5,
          "col": 4,
          "html": "<strong>Match</strong>: <br/> 5678 <br/> 1234 5678 <br/><strong>No match:</strong><br/> 1234 1234 5678 <br/> 12345 5678"
        },
        {
          "row": 6,
          "col": 4,
          "html": "<strong>Match:</strong><br/> 12345 <br/> 45678 <br/><strong>No match:</strong><br/> 1234 5678"
        },
        {
          "row": 7,
          "col": 4,
          "html": "<strong>Match</strong>: <br/> 1234 <br/> 5678 <br/> 1234 5678 <br/><strong>No Match:</strong><br/> 91011"
        },
        {
          "row": 8,
          "col": 0,
          "html": "<code>[ ]</code><br/><code>[^ ]</code>"
        },
        {
          "row": 8,
          "col": 1,
          "html": "Represents the set of AS numbers where one AS number from the list must match. <br/> Use ^ after opening the bracket to negate the set. <br/> It is also possible to reference the pre-defined num-lists from <a href=\"#community-and-num-lists\">num-list</a> with [[:numset_name:]]"
        },
        {
          "row": 8,
          "col": 4,
          "html": "<strong>Match:</strong><br/> 1234 <br/> 99 <br/> 5678 <br/><strong>No Match:</strong><br/> 101"
        },
        {
          "row": 9,
          "col": 4,
          "html": "<strong>Match:</strong><br/> 1234 <br/> 5678 9999 <br/><strong>No Match:</strong><br/> 1234 5678"
        }
      ]
    },
