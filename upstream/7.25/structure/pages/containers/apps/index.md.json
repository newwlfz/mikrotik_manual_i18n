        {
          "row": 11,
          "col": 3,
          "html": "Hardware devices that must be present on the host for the container to start. This property is configurable only after adding the YAML configuration. <br/><br/><strong>Compose format:</strong><code>[host-hw-device]:[device-in-app]</code>"
        },
        {
          "row": 12,
          "col": 3,
          "html": "Mount directories required for the container to start. This property is configurable only after adding the YAML configuration. <br/><br/><strong>Compose format:</strong><code>[dir-on-host]:[dir-in-app]</code>"
        }
      ]
