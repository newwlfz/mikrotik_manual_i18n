# Dependencies and build output
node_modules/
build/
.docusaurus/
.cache-loader/

# The local workflow may symlink the English checkout's dependencies:
# `ln -s ../repo_en/node_modules node_modules`. A trailing slash only matches a
# real directory, so ignore the symlink too.
/node_modules

# ...but `build/` above matches at any depth and would also swallow the build
# *tooling* under tools/build/, which is source: `npm run build` runs
# `node tools/build/index.mjs`. Keep the site output ignored, track the tooling.
!tools/build/
!tools/build/**

# Local environment and secrets. `.env.local` is the file the translation
# tools read (see guides/LLM.md); the examples are templates, not secrets.
.env
.env.*
.env.local
.env.*.local
!.env.example
!.env.local.example

# Logs and browser artefacts
*.log
playwright-report/
test-results/
blob-report/

# OS / editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/
.work/

.generated/

# Live-navigation crawl cache (regenerated by `npm run sidebar:crawl`).
data/nav/

# Local scratch (crawl/debug artefacts). `work/translate/` is the exception:
# a batch run must be able to resume from what the previous CI job committed,
# so a *small* part of the translation state is versioned — see below.
/work/*
!/work/translate/
/work/translate/*
# Committed translation state (kilobytes). The policy lives in
# `work/translate/README.md`; keep the two in sync when it changes.
#   README.md           what is tracked, what is rebuildable, where the rest is
#   keep-english.json   blocks that stay English on purpose; without it every
#                       batch would re-send them and `pending` never reaches 0
#   run.json            the last batch's journal (stopped reason, pending, cost)
#   checkpoint.json     explicit start/per-page/stop record: run_id, cursor,
#                       pending, TM count and the deadline-elapsed proof. The
#                       next scheduled round audits the previous run from it.
#   comment-memory.json code-fence comments, so a comment is translated once
#
# The big files here are deliberately ignored:
#   table-memory.json
#       rebuild from the overlays under `i18n/` (the table pass); the overlays
#       are the source of truth
#   tm-global.*.json
#       derived snapshot, only written by `translate tm`; `apply`, `translate`
#       and `verify` never read it
#   usage.jsonl         local cost log, not portable state
#
# Two big files *are* committed, as **baseline snapshots** (~7.4 MB packed for
# both). `translation-memory.json` is the reviewed legacy memory and cannot be
# rebuilt (its corpus is gone); `model-memory.json` is the wording the model has
# produced so far. A CI checkout used to have neither, so `translate
# --refresh-changed` had nothing to rebuild a changed page from and every batch
# re-translated from scratch. From the baseline on, a batch only **appends**
# small `shards/*.json` files (the baseline itself is not rewritten, see
# `tools/translate/lib/model-memory.mjs`); loading merges baseline + shards.
# Keep them in the repository, not as an out-of-repo backup.
!/work/translate/README.md
!/work/translate/keep-english.json
!/work/translate/run.json
!/work/translate/checkpoint.json
!/work/translate/comment-memory.json
!/work/translate/translation-memory.json
!/work/translate/model-memory.json
# Incremental memory shards. A batch gets its new translations into git through
# these small append-only files; `node tools/translate` writes them and the
# loading code merges them over the baseline (shards win). See
# `work/translate/README.md` § 七.
!/work/translate/shards/
!/work/translate/shards/*.json

# Per-run journal of `npm run sync -- --update`; regenerated on every run.
state/update-run.json

# Content: not authored here. The hub (`mikrotik_manual_i18n`) owns the English
# source and publishes it by **git push**: every root in its
# `tools/content/publish.mjs` CONTENT_ROOTS is committed into this repository by
# the `publish-content` job, together with `locales.json` — `docs/`,
# `versioned_docs/`, `hardware/`, `blog/`, `changelog/`, `data/`,
# `sidebars.ts`, `sidebars-hardware.ts`, `versioned_sidebars/` and
# `versions.json`.
#
# None of them may be ignored here: an ignored root makes the hub's publish fail
# before it commits, and the translation plan / build would silently see fewer
# pages than the site actually has. The explicit `!` rules below document the
# contract and keep it true if an ignore pattern is added above later.
#
# Leading `/`: only the repository roots are content. An unanchored `hardware/`
# would also swallow `i18n/.../hardware/` and `docs/.../hardware/` overlays.
!/docs/
!/versioned_docs/
!/hardware/
!/blog/
!/changelog/
!/data/
!/sidebars.ts
!/sidebars-hardware.ts
!/versioned_sidebars/
!/versions.json
!/locales.json

# Assets are not content here: they are served from the English site
# (`ASSET_ORIGIN`), so a local `static/` must stay out of git.
/static/

# Local crawl staging (`npm run content:fetch` writes `.content/fetch.json`).
/.content/
