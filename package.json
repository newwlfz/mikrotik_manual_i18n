{
  "name": "mikrotik-manual-mirror",
  "version": "0.1.0",
  "private": true,
  "description": "Source-faithful, incrementally synchronised mirror of manual.mikrotik.com",
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "node tools/build/index.mjs",
    "build:lowmem": "BUILD_HEAP_MB=6144 node tools/build/index.mjs",
    "build:slim": "node tools/build/slim.mjs",
    "fences:check": "node tools/build/normalize-fences.mjs --check",
    "fences:normalize": "node tools/build/normalize-fences.mjs",
    "llms:build": "node tools/build/llms.mjs",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "sync": "node tools/sync/index.mjs",
    "translate": "node tools/translate/index.mjs",
    "verify": "node tools/pipeline/verify.mjs",
    "cli:build": "node tools/cli/build-all.mjs",
    "metadata:build": "node tools/sync/build-all.mjs",
    "metadata:apply": "node tools/sync/apply-doc-metadata.mjs",
    "categories:build": "node tools/sync/build-category-metadata.mjs",
    "sidebar:order": "node tools/sync/apply-sidebar-order.mjs",
    "version:snapshot": "node tools/sync/snapshot-version.mjs",
    "version:install": "node tools/sync/install-version.mjs",
    "version:sidebars": "node tools/sync/build-sidebars.mjs --compare",
    "version:sidebars:all": "node tools/sync/sync-sidebars.mjs",
    "version:sidebars:rebuild": "node tools/sync/sync-sidebars.mjs --no-crawl",
    "translate:legacy": "node tools/translate/index.mjs import-legacy",
    "translate:harvest": "node tools/translate/harvest.mjs",
    "translate:apply": "node tools/pipeline/translate.mjs --mode=apply",
    "translate:plan": "node tools/pipeline/translate.mjs --plan",
    "translate:verify": "node tools/translate/index.mjs verify",
    "translate:verify:all": "node tools/translate/index.mjs verify --all-locales",
    "translate:admonitions": "node tools/translate/index.mjs admonitions",
    "translate:review": "node tools/translate/review.mjs",
    "translate:selftest": "node tools/translate/selftest.mjs",
    "translate:links": "node tools/translate/normalize-links.mjs",
    "translate:links:check": "node tools/translate/normalize-links.mjs --check",
    "fix:fences": "node tools/translate/fix-fence-language.mjs",
    "fix:fences:check": "node tools/translate/fix-fence-language.mjs --check",
    "translate:comments": "node tools/translate/index.mjs comments",
    "translate:audit-comments": "node tools/translate/audit-code-comments.mjs --write",
    "translate:tm": "node tools/translate/index.mjs tm",
    "sync:assets": "node tools/sync/fetch-assets.mjs",
    "sync:prune": "node tools/sync/prune-orphans.mjs",
    "assets:address": "node tools/sync/address-images.mjs --write",
    "assets:address:dry": "node tools/sync/address-images.mjs --dry-run",
    "pipeline:sync": "node tools/pipeline/sync.mjs",
    "pipeline:translate": "node tools/pipeline/translate.mjs",
    "pipeline:build": "node tools/pipeline/build.mjs",
    "pipeline:verify": "node tools/pipeline/verify.mjs",
    "pipeline:report": "node tools/pipeline/report.mjs",
    "sync:pdfs": "node tools/sync/sync-pdfs.mjs",
    "sync:pdf-links": "node tools/sync/capture-pdf-links.mjs",
    "upstream:fetch": "node tools/sync/fetch-upstream.mjs",
    "upstream:verify": "node tools/sync/verify-upstream.mjs",
    "structure:cache": "node tools/sync/cache-structure.mjs",
    "structure:check": "node tools/sync/check-structure.mjs",
    "materialize": "node tools/sync/materialize.mjs",
    "translate:derive": "node tools/pipeline/translate.mjs --mode=derive",
    "sidebar:crawl": "node tools/sync/crawl-nav.mjs --all",
    "verify:sidebar": "node tools/verify/sidebar-consistency.mjs",
    "verify:sidebar:strict": "node tools/verify/sidebar-consistency.mjs --strict",
    "verify:assets": "node tools/verify/asset-refs.mjs",
    "verify:base-url": "node tools/verify/base-url-refs.mjs",
    "verify:llms": "node tools/verify/llms-links.mjs",
    "verify:fences": "node tools/verify/fence-coverage.mjs --strict",
    "verify:deploy": "node tools/build/slim.mjs && node tools/verify/asset-refs.mjs && node tools/verify/base-url-refs.mjs && node tools/verify/orphan-assets.mjs && node tools/verify/llms-links.mjs",
    "verify:ui": "node tools/verify/browser-check.mjs",
    "test:locale": "node tools/verify/locale-path.test.mjs",
    "verify:tables": "node tools/verify/table-coverage.mjs",
    "verify:tables:check": "node tools/verify/table-coverage.mjs --check",
    "verify:labels": "node tools/verify/labels.mjs",
    "verify:links": "node tools/verify/links.mjs",
    "verify:anchors": "node tools/verify/anchors.mjs",
    "verify:images": "node tools/verify/images.mjs",
    "verify:orphan-assets": "node tools/verify/orphan-assets.mjs",
    "translate:cli": "node tools/translate/cli-tables.mjs",
    "verify:cli": "node tools/verify/cli-tables.mjs",
    "fix:known": "node tools/translate/apply-known-translations.mjs"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/plugin-content-blog": "3.10.2",
    "@docusaurus/plugin-content-docs": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "@mdx-js/react": "^3.0.0",
    "@mermaid-js/layout-elk": "^0.1.9",
    "cheerio": "1.0.0-rc.12",
    "clsx": "^2.0.0",
    "medium-zoom": "^1.1.0",
    "mermaid": "11.17.2",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "docusaurus-plugin-llms": "0.6.1",
    "pagefind": "^1.6.0",
    "playwright-core": "^1.64.1",
    "turndown": "^7.2.5",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "~5.6.2"
  },
  "engines": {
    "node": ">=20.0"
  }
}
