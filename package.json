{
  "name": "mikrotik-manual-mirror",
  "version": "0.1.0",
  "private": true,
  "description": "Source-faithful, incrementally synchronised mirror of manual.mikrotik.com",
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "npm run cli:build && docusaurus build && pagefind --site build",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "sync": "node tools/sync/index.mjs",
    "translate": "node tools/translate/index.mjs",
    "verify": "node tools/verify/index.mjs",
    "cli:build": "node tools/cli/build-cli-data.mjs && cp data/cli/$(node -p \"require('./data/manifests/current-version.json').version\")/en.json static/cli/current.json",
    "metadata:build": "node tools/sync/extract-doc-metadata.mjs",
    "metadata:apply": "node tools/sync/apply-doc-metadata.mjs",
    "categories:build": "node tools/sync/build-category-metadata.mjs"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.1",
    "@docusaurus/plugin-content-blog": "3.10.1",
    "@docusaurus/plugin-content-docs": "3.10.1",
    "@docusaurus/preset-classic": "3.10.1",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.1",
    "@docusaurus/tsconfig": "3.10.1",
    "@docusaurus/types": "3.10.1",
    "docusaurus-plugin-llms": "0.6.1",
    "pagefind": "^1.6.0",
    "playwright-core": "^1.64.1",
    "turndown": "^7.2.5",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "~5.6.2"
  },
  "engines": {
    "node": ">=20.0"
  }
}
